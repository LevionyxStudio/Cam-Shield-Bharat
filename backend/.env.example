# FraudShield AI - Backend Environment Variables
# Copy this file to .env and fill in your values

# Server
HOST=0.0.0.0
PORT=8000
DEBUG=true

# AI Provider
AI_PROVIDER=ollama

# Ollama
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=qwen2.5:1.5b
OLLAMA_TIMEOUT=60.0

# Speech-to-Text
STT_PROVIDER=demo

# Firebase
FIREBASE_ENABLED=false
FIREBASE_CREDENTIALS_PATH=
FIREBASE_PROJECT_ID=

# Security
API_KEY=
CORS_ORIGINS=*
